#: oneclickbios@sao.studio/extension.js:35
msgid "Restart into Firmware Settings…"
msgstr "Reiniciar en la configuración del firmware…"

#: oneclickbios@sao.studio/extension.js:36
msgid "Restart into Firmware Settings"
msgstr "Reiniciar en la configuración del firmware"

#: oneclickbios@sao.studio/extension.js:38
#, javascript-format
msgid ""
"The system will restart into firmware settings automatically in %d second"
msgid_plural ""
"The system will restart into firmware settings automatically in %d seconds"
msgstr[0] "El sistema se reiniciará automáticamente en %d segundo y abrirá la configuración del firmware"
msgstr[1] "El sistema se reiniciará automáticamente en %d segundos y abrirá la configuración del firmware"

#: oneclickbios@sao.studio/extension.js:41
msgid "This computer does not support restarting into firmware settings"
msgstr "Esta computadora no admite reiniciar en la configuración del firmware"

#: oneclickbios@sao.studio/extension.js:42
msgid "Restarting into firmware settings is not allowed"
msgstr "No está permitido reiniciar en la configuración del firmware"

#: oneclickbios@sao.studio/extension.js:43
msgid "Could not restart into firmware settings"
msgstr "No se pudo reiniciar en la configuración del firmware"
